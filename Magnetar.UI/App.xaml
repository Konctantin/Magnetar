<Application x:Class="Magnetar.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Magnetar.UI"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Editor/MacroCodeEditor.xaml" />
                <ResourceDictionary>
                    <ContextMenu x:Key="TrayMenu">
                        <MenuItem Header="Открыть окно" Command="{Binding ShowWindowCommand}" FontWeight="Bold"/>
                        <Separator />
                        <MenuItem Header="Выход" Command="{Binding ExitCommand}"/>
                    </ContextMenu>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
