<Window x:Class="Magnetar.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Magnetar.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        >
    <Grid Background="#222222">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Привязываем источник картинки к свойству CurrentImage из ViewModel -->
            <Border BorderBrush="White" BorderThickness="2" CornerRadius="5" Margin="10">
                <Image Source="{Binding CurrentImage}" Width="200" Height="200" Stretch="Uniform"/>
            </Border>

            <TextBlock Text="Обновление: 10 раз в сек." Foreground="Gray" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
